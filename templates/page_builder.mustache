{{!
    @template theme_degrade/page_builder

    Page builder wrapper for Moodle page activities managed by the theme editor.

    Example context (json):
    {
      "title": "Theme page editor",
      "description": "Add, reorder and edit visual blocks for this Moodle page.",
      "viewurl": "https://example.com/mod/page/view.php?id=2",
      "editurl": "https://example.com/course/modedit.php?update=2",
      "csslink": "<link rel=\"stylesheet\" href=\"/theme/degrade/_editor/model/_assets/style.css\">",
      "editorcontext": {}
    }
}}
<div class="theme-degrade-page-builder">
    <div class="theme-degrade-page-builder-header mb-3">
        <h2>{{title}}</h2>
        <p class="text-muted">{{description}}</p>

        <div class="mb-3 d-flex gap-2 flex-wrap">
            <a class="btn btn-secondary" href="{{{viewurl}}}">{{#str}}pageeditor_view_page, theme_degrade{{/str}}</a>
            <a class="btn btn-outline-secondary" href="{{{editurl}}}">{{#str}}pageeditor_activity_settings, theme_degrade{{/str}}</a>
        </div>
    </div>

    {{{csslink}}}
    {{#editorcontext}}
        {{> theme_degrade/frontpage_editor }}
    {{/editorcontext}}
</div>
